// Cloudflare Workers config: serves the Eleventy build (_site/) as static assets.
// `previews` is required for the branch preview deploys (`npx wrangler preview`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saratogaflyers",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./_site"
  },
  "previews": {}
}
