{#- Navigation structure lives here (not in the CMS) on purpose. -#}
{%- set navItems = [
  { href: "index.html", label: "Home" },
  { href: "our-plane.html", label: "Our Plane" },
  { href: "resources.html", label: "Resources" },
  { href: "more-info.html", label: "Contact Us" }
] -%}
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="index.html"><img src="images/logo.jpg" alt="">{{ site.clubName }}</a>
    <nav class="site-nav">
      {%- for item in navItems %}
      <a href="{{ item.href }}"{% if page.filePathStem + ".html" == "/" + item.href %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>
  </div>
</header>
